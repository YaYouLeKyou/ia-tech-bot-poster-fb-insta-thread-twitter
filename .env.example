# ─────────────────────────────────────────────────────────────
# Agent Twitter — Veille IA & Tech
# Copiez ce fichier en `.env` et renseignez vos clés
# ─────────────────────────────────────────────────────────────

# ── Clés API Twitter (X) — API V2 ────────────────────────────
# https://developer.twitter.com/en/portal/dashboard
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# ── Clé API LLM — Gemini (principal, gratuit, fiable) ────────
# Gemini : https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
# Nombre max de tokens — Gemini a un mode "thinking" qui consomme
# des tokens avant la réponse. 2000 garantit un tweet complet.
LLM_MAX_TOKENS=2000

# ── Fallback LLM — Groq (si Gemini est indisponible) ─────────
# Groq : https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=groq/compound-mini

# ── API Facebook / Meta (Graph API) ────────────────────────────
# • Page Access Token (permanent) : https://developers.facebook.com/tools/access-token/
#   Permissions requises : pages_read_engagement, pages_manage_posts
# • Facebook Page ID : récupérable via /meapr après génération du token
# • Instagram Business Account ID : lié à la page Facebook
FB_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# ── API Threads (Meta) ─────────────────────────────────────────
# • Threads User ID : ID numérique du compte Threads
# • Threads Access Token : token d'accès Threads (60 jours, rafraîchissable)
#   Généré via https://developers.facebook.com/
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ── Flux RSS (optionnel — sinon ceux de config.py sont utilisés)
# RSS_FEED_URLS=https://www.presse-citron.net/feed/,https://techcrunch.com/category/artificial-intelligence/feed/

# ── Planification (optionnel — défauts : 08:30 et 17:30 UTC) ─
# Format HH:MM (24h), séparés par des virgules
# SCHEDULE_TIMES=08:30,17:30

# ── Fréquence alternative (si SCHEDULE_TIMES est vide) ───────
# NEWS_INTERVAL_HOURS=2

# ── Port du serveur web ──────────────────────────────────────
# WEB_PORT=5000

# ── Mode test ────────────────────────────────────────────────
# true = exécute un cycle complet (génération + publication) immédiatement au lancement
# (utile pour valider la config sur Render/Railway)
TEST_ON_STARTUP=false

# ── Mode simulation (Dry-Run) ────────────────────────────────
# true  = affiche le tweet dans la console, ne publie PAS sur Twitter
# false = publie réellement sur Twitter (comportement normal)
# ⚠️  Mettez DRY_RUN=true pour tester sans risque avant la mise en production
DRY_RUN=false