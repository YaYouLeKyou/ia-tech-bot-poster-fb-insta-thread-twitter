# ─────────────────────────────────────────────────────────────
# Agent Twitter — Veille IA & Tech
# Copiez ce fichier en `.env` et renseignez vos clés
# ─────────────────────────────────────────────────────────────

# ── Clés API Twitter (X) — API V2 ────────────────────────────
# https://developer.twitter.com/en/portal/dashboard
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# ── Clé API LLM (OpenAI / DeepSeek / Groq, compatible OpenAI SDK) ──
# DeepSeek : https://platform.deepseek.com/api_keys
# OpenAI   : https://platform.openai.com/api-keys
# Groq     : https://console.groq.com/keys
LLM_API_KEY=
# URL de l'API — DeepSeek : https://api.deepseek.com
# OpenAI : https://api.openai.com/v1
# Groq   : https://api.groq.com/openai/v1
LLM_BASE_URL=https://api.deepseek.com

# Modèle — DeepSeek : deepseek-chat | OpenAI : gpt-4o-mini | Groq : llama-3.1-8b-instant
LLM_MODEL=deepseek-chat

# ── Flux RSS (optionnel — sinon ceux de config.py sont utilisés)
# RSS_FEED_URLS=https://www.presse-citron.net/feed/,https://techcrunch.com/category/artificial-intelligence/feed/

# ── Planification (optionnel — défauts : 08:30 et 17:30 UTC) ─
# Format HH:MM (24h), séparés par des virgules
# SCHEDULE_TIMES=08:30,17:30

# ── Fréquence alternative (si SCHEDULE_TIMES est vide) ───────
# NEWS_INTERVAL_HOURS=2

# ── Port du serveur web ──────────────────────────────────────
# WEB_PORT=5000

# ── Mode test ────────────────────────────────────────────────
# true = exécute un cycle complet (génération + publication) immédiatement au lancement
# (utile pour valider la config sur Render/Railway)
TEST_ON_STARTUP=false

# ── Mode simulation (Dry-Run) ────────────────────────────────
# true  = affiche le tweet dans la console, ne publie PAS sur Twitter
# false = publie réellement sur Twitter (comportement normal)
# ⚠️  Mettez DRY_RUN=true pour tester sans risque avant la mise en production
DRY_RUN=false